{
  "databricks_default": {
    "conn_type": "databricks",
    "host": "https://<your-workspace>.cloud.databricks.com",
    "password": "<databricks personal access token>",
    "extra": { "warehouse_id": "<SQL warehouse id>" }
  },
  "taxi_storage": {
    "conn_type": "aws",
    "login": "<dvc access key>",
    "password": "<dvc secret key>",
    "extra": { "endpoint_url": "http://host.docker.internal:8333" }
  }
}
