[Unit]
Description=NYC taxi MLOps: wake Airflow, run the monthly refresh + training, sleep again
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=shadmanarko
Environment=APP_DIR=/srv/apps/taxi-mlops
EnvironmentFile=/srv/apps/taxi-mlops/airflow-monthly.env
ExecStart=/srv/apps/taxi-mlops/infra/server/airflow-monthly.sh
TimeoutStartSec=4h
