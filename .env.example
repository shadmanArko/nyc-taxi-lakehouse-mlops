# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Secrets for deployed services live as files under /srv/apps/<project>/secrets/
# on the server, never in environment variables or in Git.

# --- API -------------------------------------------------------------------
TAXI_API_LOG_LEVEL=INFO
# MLflow model URI the API serves, e.g. models:/taxi-trip-duration@champion
# Left empty until Phase 5: the API then reports "not ready" on /ready and /predict.
TAXI_API_MODEL_URI=
# Host port the API is published on (always bound to 127.0.0.1).
API_HOST_PORT=8000
